{
  "name": "mini-iot-utopia-frontend",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://mini-iot-utopia-backend.onrender.com/api",
    "VITE_SOCKET_URL": "https://mini-iot-utopia-backend.onrender.com"
  }
}
